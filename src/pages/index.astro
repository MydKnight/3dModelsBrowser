---
// Gallery page -- hosts the single filter island (spec D1).
// filter-index.json is produced by `npm run data` (scan-nas -> build-filter-index)
// and committed. Locally, scripts/dev-bootstrap-raw.mjs generates it from the
// legacy snapshot until the real NAS scan has run.
import Base from '../layouts/Base.astro';
import GalleryIsland from '../components/GalleryIsland.tsx';
import type { FilterIndex } from '../lib/filter-engine';
import filterIndex from '../data/filter-index.json';

const index = filterIndex as FilterIndex;
---

<Base title="3D Model Gallery">
  <style is:global>
    :root { --surface: Canvas; --accent: #3b6ea5; --chip: #8882; }

    .gallery { display: flex; flex-direction: column; height: calc(100vh - 42px); }

    /* --- top bar ------------------------------------------------------ */
    .topbar {
      display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
      padding: 8px 16px; border-bottom: 1px solid var(--edge);
    }
    .topbar-search { flex: 1 1 180px; min-width: 140px; padding: 6px 8px; }
    .topbar-sort { display: inline-flex; align-items: center; gap: 4px; font-size: 0.9em; }
    .filters-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 12px; cursor: pointer;
      border: 1px solid var(--edge); border-radius: 6px; background: transparent;
    }
    .filters-btn .badge, .group-dropdown .badge {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 1.4em; height: 1.4em; padding: 0 0.35em;
      font-size: 0.78em; border-radius: 999px;
      background: var(--accent); color: #fff;
    }

    /* --- active-filter chips ---------------------------------------- */
    .chip-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 16px; }
    .chip-bar:empty { display: none; }
    .chip {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 3px 10px; font-size: 0.85em; cursor: pointer;
      border: 1px solid var(--edge); border-radius: 999px; background: var(--chip);
    }
    .chip-clear { background: transparent; font-weight: 600; }

    /* --- results --------------------------------------------------- */
    .results { display: flex; flex-direction: column; flex: 1; min-height: 0; }
    .result-count { margin: 8px 16px; }
    .scroller { flex: 1; overflow-y: auto; padding: 0 16px 16px; }
    .empty { margin: 24px 16px; opacity: 0.7; }
    .card { display: block; text-decoration: none; }
    .card img { width: 100%; height: 240px; object-fit: contain; background: #8881; border-radius: 6px; }
    .card-name { display: block; font-size: 0.9em; margin-top: 4px; }
    .count { opacity: 0.6; font-size: 0.85em; }

    /* --- filter drawer ------------------------------------------------ */
    .drawer-root[hidden] { display: none; }
    .drawer-backdrop { position: fixed; inset: 0; background: #0007; z-index: 20; }
    .drawer {
      position: fixed; top: 0; right: 0; bottom: 0; z-index: 21;
      width: min(380px, 90vw); display: flex; flex-direction: column;
      background: var(--surface); border-left: 1px solid var(--edge);
      box-shadow: -8px 0 24px #0004;
    }
    @media (max-width: 700px) { .drawer { width: 100%; border-left: 0; } }
    .drawer-head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 16px; border-bottom: 1px solid var(--edge);
    }
    .drawer-head h2 { margin: 0; font-size: 1.1em; }
    .drawer-close { font-size: 1.4em; line-height: 1; background: transparent; border: 0; cursor: pointer; padding: 4px 8px; }
    .drawer-body { flex: 1; overflow-y: auto; padding: 12px 16px; }
    .drawer-body .subs { border: 0; padding: 0; margin: 0 0 12px; }
    .drawer-body .subs legend { font-weight: 600; padding: 0; }
    .drawer-body label { display: flex; align-items: center; gap: 6px; padding: 3px 0; }
    .drawer-foot { display: flex; gap: 8px; padding: 12px 16px; border-top: 1px solid var(--edge); }
    .drawer-foot .primary {
      flex: 1; padding: 8px; cursor: pointer;
      background: var(--accent); color: #fff; border: 0; border-radius: 6px;
    }
    .drawer-foot button:not(.primary) { padding: 8px 12px; cursor: pointer; background: transparent; border: 1px solid var(--edge); border-radius: 6px; }

    .group-dropdown { border-top: 1px solid var(--edge); }
    .group-dropdown summary {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 2px; cursor: pointer; font-weight: 600; list-style: none;
    }
    .group-dropdown summary::-webkit-details-marker { display: none; }
    .group-dropdown summary::before { content: '\25B8'; opacity: 0.6; font-weight: 400; }
    .group-dropdown[open] summary::before { content: '\25BE'; }
    .group-dropdown .group-label { flex: 1; }
    .group-filter { width: 100%; padding: 5px 8px; margin: 4px 0 8px; }
    .group-options { max-height: 40vh; overflow-y: auto; padding-bottom: 8px; }
    .group-options label { font-weight: 400; }
    .group-options input:disabled + * , .group-options label:has(input:disabled) { opacity: 0.4; }
  </style>
  <GalleryIsland index={index} client:load transition:persist transition:name="gallery" />
</Base>
