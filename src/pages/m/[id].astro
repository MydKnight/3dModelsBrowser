---
// Per-model detail page (spec D3). Static: one HTML page per model, full
// metadata inlined, 900px WebP. No island -- just a small copy-link script.
import Base from '../../layouts/Base.astro';
import type { FilterIndex } from '../../lib/filter-engine';
import { detailPaths } from '../../lib/detail-paths';
import filterIndex from '../../data/filter-index.json';
import details from '../../data/details.json';

export function getStaticPaths() {
  return detailPaths(filterIndex as FilterIndex, details as any);
}

const { id, entry, prevId, nextId } = Astro.props;
const added = new Date(entry.dateAdded).toLocaleDateString();
---

<Base title={`${entry.name} -- 3D Model Gallery`}>
  <main class="detail">
    <nav class="detail-nav">
      <a href="/">&larr; Gallery</a>
      <span>
        {prevId && <a href={`/m/${prevId}`} rel="prev" data-nav="prev">&larr; Prev</a>}
        {nextId && <a href={`/m/${nextId}`} rel="next" data-nav="next">Next &rarr;</a>}
      </span>
    </nav>

    <img class="detail-img" src={`/detail/${id}.webp`} alt={entry.name} width="900" height="900" />

    <h1>{entry.name}</h1>
    <dl>
      <div><dt>Subscription</dt><dd>{entry.subscription}</dd></div>
      {entry.release && <div><dt>Release</dt><dd>{entry.release}</dd></div>}
      <div><dt>Added</dt><dd>{added}</dd></div>
      <div><dt>Path</dt><dd><code>{entry.relPath}</code></dd></div>
    </dl>

    {entry.tags.length > 0 && (
      <ul class="detail-tags">
        {entry.tags.map((t: string) => <li>{t}</li>)}
      </ul>
    )}

    <button type="button" id="copy-link">Copy link</button>
  </main>

  <style is:global>
    .detail { max-width: 900px; margin: 0 auto; padding: 16px; }
    .detail-nav { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
    .detail-nav a { text-decoration: none; }
    .detail-img { width: 100%; height: auto; background: #8881; border-radius: 8px; }
    .detail dl > div { display: flex; gap: 8px; margin: 4px 0; }
    .detail dt { font-weight: 700; min-width: 110px; }
    .detail-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; }
    .detail-tags li { border: 1px solid var(--edge); border-radius: 12px; padding: 2px 10px; font-size: 0.85em; }
  </style>

  <script>
    document.getElementById('copy-link')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(location.href);
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = 'Copy link'), 2000);
      } catch {
        btn.textContent = 'Copy failed';
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') (document.querySelector('[data-nav="prev"]') as HTMLAnchorElement)?.click();
      if (e.key === 'ArrowRight') (document.querySelector('[data-nav="next"]') as HTMLAnchorElement)?.click();
    });
  </script>
</Base>
