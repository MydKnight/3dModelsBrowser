---
// Shared shell. <ClientRouter /> gives View Transitions so navigating to a
// /m/[id] page and back keeps the transition:persist'd gallery island alive
// (spec D1/O1).
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
    <style is:global>
      :root { color-scheme: light dark; --edge: #8883; }
      * { box-sizing: border-box; }
      body { margin: 0; font: 15px/1.4 system-ui, sans-serif; }
      a { color: inherit; }
      .site-header { padding: 10px 16px; border-bottom: 1px solid var(--edge); font-weight: 700; }
      .site-header a { text-decoration: none; }
      .site-footer { padding: 16px; border-top: 1px solid var(--edge); font-size: 0.85em; opacity: 0.7; }
    </style>
  </head>
  <body>
    <header class="site-header"><a href="/">3D Model Gallery</a></header>
    <slot />
    <footer class="site-footer">Personal catalogue. Data from Orynt3D via orynt3d-pipeline.</footer>
  </body>
</html>
