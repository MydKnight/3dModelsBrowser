# Copy to `.env` next to compose.nas.yml on the QNAP and fill in.
# `chmod 600 .env`. Never commit the real file.
# Docker Compose auto-loads `.env` from the compose file's directory.

# Fine-grained GitHub PAT, this repo only, Contents: Read and write.
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# QNAP-local path to the 3D Files share (find /share -maxdepth 3 -name '3D Files' -type d)
NAS_3DFILES=/share/CACHEDEV1_DATA/data/3D Files

# Optional: which branch the snapshot commit lands on.
# feat/nas-data-container until astro-rewrite merges, then main.
# TARGET_BRANCH=feat/nas-data-container
